# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=gmail_manager
POSTGRES_PASSWORD=<required_strong_password>
POSTGRES_DB=gmail_manager
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Google OAuth (required) ──────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=<required>
GOOGLE_CLIENT_SECRET=<required>
# The single Gmail address allowed to log in
GOOGLE_ALLOWED_EMAIL=<required_your_gmail_address>

# ─── App / Security ──────────────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=<required_random_64_char_hex>
# JWT_SECRET is optional; falls back to APP_SECRET_KEY if unset
# JWT_SECRET=

PUBLIC_BASE_URL=https://<your-domain>

# ─── Ports (mapped by Docker Compose) ────────────────────────────────────────
BACKEND_PORT=8003
FRONTEND_PORT=3003

# ─── Optional / Defaults shown ───────────────────────────────────────────────
# LOG_LEVEL=INFO
# JWT_ALGORITHM=HS256
# JWT_EXP_MINUTES=30
# JWT_COOKIE_NAME=gmail_auth
# JWT_COOKIE_SECURE=true
# JWT_COOKIE_SAMESITE=lax
